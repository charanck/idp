// Package layout provides the shared page chrome (sidebar/topbar/flash
// messages) for every web UI page, mirroring web_ui/templates/web_ui/base.html.
package layout

import (
	"controlplane/internal/notification"
	"controlplane/internal/session"
)

// NavUser is the current-user view the layout needs to render the sidebar
// and topbar, decoupled from the auth package to avoid an import cycle with
// the webui package (which imports views/pages, which imports this package).
type NavUser struct {
	LoggedIn    bool
	Email       string
	IsStaff     bool
	Modules     map[string]bool
	CSRFToken          string
	ProductName        string
	LogoURL            string
	AccentColor        string
	BackgroundImageURL string
}

// HasModule reports whether the current user's effective group permissions
// grant access to module (one of the auth.Module* keys).
func (u NavUser) HasModule(module string) bool {
	return u.Modules[module]
}

// DisplayName returns the deployment's branded product name, falling back to
// "Control Plane" when no admin-configured name is set.
func (u NavUser) DisplayName() string {
	if u.ProductName != "" {
		return u.ProductName
	}
	return "Control Plane"
}

// defaultAccentColor mirrors the indigo the login screen falls back to when
// no branding AccentColor is configured (see also
// pages.defaultAccentColor, which the Branding settings form's color-picker
// input falls back to - kept in sync manually since the two packages don't
// share a dependency).
const defaultAccentColor = "#4f46e5"

// AccentColorOrDefault returns the deployment's branded accent color,
// falling back to defaultAccentColor when unset. Rendered as a CSS custom
// property so per-deployment theming works without a CSS rebuild (the
// compiled Tailwind utility classes used elsewhere in the app chrome are
// fixed at build time and intentionally left untouched by this).
func (u NavUser) AccentColorOrDefault() string {
	if u.AccentColor != "" {
		return u.AccentColor
	}
	return defaultAccentColor
}

templ Base(title string, activeNav string, user NavUser, flashes []session.Flash) {
	<!DOCTYPE html>
	<html lang="en" style={ "--accent:" + user.AccentColorOrDefault() + ";" }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · { user.DisplayName() }</title>
			<script>
				// Applied before first paint (blocking, no defer) so the page never
				// flashes the wrong theme. Mirrors the persistence logic in
				// /static/theme.js's toggle handler.
				(function() {
					try {
						var stored = localStorage.getItem("cp-theme");
						var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
						if (dark) document.documentElement.classList.add("dark");
					} catch (e) {}
				})();
			</script>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
			<link href="/static/app.css" rel="stylesheet"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
			<script src="https://unpkg.com/htmx-ext-response-targets@2.0.2/response-targets.js" defer></script>
			<script src="https://unpkg.com/alpinejs@3.14.9/dist/cdn.min.js" defer></script>
			<script src="/static/theme.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body hx-ext="response-targets">
			@toastContainer()
			if user.LoggedIn {
				<div class="app-shell">
					@sidebar(activeNav, user)
					<div class="content">
						@topbar(user)
						<main class="page">
							@Flashes(flashes)
							{ children... }
						</main>
					</div>
				</div>
			} else {
				<main
					class="auth-shell"
					if user.BackgroundImageURL != "" {
						style={ "background-image: linear-gradient(rgba(15,23,42,0.55), rgba(15,23,42,0.55)), url('" + user.BackgroundImageURL + "');" }
					}
				>
					@Flashes(flashes)
					{ children... }
				</main>
			}
		</body>
	</html>
}

templ sidebar(activeNav string, user NavUser) {
	<div class="sidebar">
		<a href="/dashboard/" class="brand">
			if user.LogoURL != "" {
				<img src={ user.LogoURL } alt="" class="brand-logo"/>
			}
			{ user.DisplayName() }
		</a>
		<nav>
			<ul>
				@navLinkAlpha(activeNav, "dashboard", "/dashboard/", "bi-speedometer2", "Dashboard")
				if user.HasModule("applications") {
					@navLink(activeNav, "applications", "/applications/", "bi-grid-3x3-gap", "Applications")
				}
				if user.HasModule("environments") {
					@navLink(activeNav, "environments", "/environments/", "bi-layers", "Environments")
				}
				if user.HasModule("configs") {
					@navLink(activeNav, "configs", "/configs/", "bi-sliders", "Configs & Secrets")
				}
				if user.HasModule("flags") {
					@navLink(activeNav, "flags", "/flags/", "bi-toggle-on", "Feature Flags")
				}
				if notification.Enabled {
					@navLinkAlpha(activeNav, "notifications", "/notifications/", "bi-bell", "Notifications")
				}
			</ul>
		</nav>
		if user.HasModule("users") || user.HasModule("groups") || user.HasModule("service_clients") || user.HasModule("oauth_providers") || user.HasModule("policies") || user.HasModule("branding") {
			<details class="sidebar-group" open>
				<summary>Identity &amp; Access</summary>
				<nav>
					<ul>
						if user.HasModule("users") {
							@navLinkAlpha(activeNav, "users", "/users/", "bi-people", "Users")
						}
						if user.HasModule("groups") {
							@navLinkAlpha(activeNav, "groups", "/groups/", "bi-diagram-3", "Groups")
						}
						if user.HasModule("service_clients") {
							@navLink(activeNav, "clients", "/clients/", "bi-hdd-network", "Service Clients")
						}
						if user.HasModule("oauth_providers") {
							@navLinkAlpha(activeNav, "oauth_providers", "/oauth/providers/", "bi-shield-lock", "OAuth Providers")
						}
						if user.HasModule("policies") {
							@navLinkAlpha(activeNav, "policies", "/policies/", "bi-file-earmark-lock", "Policies")
						}
						if user.HasModule("branding") {
							@navLinkAlpha(activeNav, "branding", "/branding/", "bi-palette", "Branding")
						}
					</ul>
				</nav>
			</details>
		}
		if notification.Enabled && user.HasModule("notification_settings") {
			<nav>
				<ul>
					@navLinkAlpha(activeNav, "notification_settings", "/notification-settings/", "bi-bell", "Notification Settings")
				</ul>
			</nav>
		}
		if user.HasModule("activity_log") {
			<nav>
				<ul>
					@navLinkAlpha(activeNav, "activity", "/activity/", "bi-clock-history", "Activity Log")
				</ul>
			</nav>
		}
	</div>
}

templ navLink(activeNav, key, href, icon, label string) {
	@navLinkTagged(activeNav, key, href, icon, label, false)
}

// navLinkAlpha is navLink plus a small "Alpha" badge, for modules that
// aren't yet considered stable.
templ navLinkAlpha(activeNav, key, href, icon, label string) {
	@navLinkTagged(activeNav, key, href, icon, label, true)
}

templ navLinkTagged(activeNav, key, href, icon, label string, alpha bool) {
	<li>
		if activeNav == key {
			<a href={ templ.URL(href) } class="active" aria-current="page">
				<i class={ "bi", icon }></i>{ label }
				if alpha {
					@AlphaBadge("nav-alpha-badge")
				}
			</a>
		} else {
			<a href={ templ.URL(href) }>
				<i class={ "bi", icon }></i>{ label }
				if alpha {
					@AlphaBadge("nav-alpha-badge")
				}
			</a>
		}
	</li>
}

// AlphaBadge renders the sidebar nav's small "Alpha" pill for modules that
// aren't yet considered stable. Page headers render the equivalent
// `<span class="badge badge-alpha">Alpha</span>` inline, matching how every
// other status badge in web/template/pages is written.
templ AlphaBadge(class string) {
	<span class={ class } title="This feature is in alpha and may change">Alpha</span>
}

templ topbar(user NavUser) {
	<div class="topbar">
		<span class="user-email" title={ user.Email }>{ user.Email }</span>
		<button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
			<i class="bi bi-moon-stars"></i>
			<i class="bi bi-sun"></i>
		</button>
		<a role="button" class="btn-sm outline secondary" href="/password/change/">Change Password</a>
		<form method="post" action="/logout/" class="m-0">
			<input type="hidden" name="csrf_token" value={ user.CSRFToken }/>
			<button class="btn-sm btn-danger outline" type="submit">Logout</button>
		</form>
	</div>
}

templ Flashes(flashes []session.Flash) {
	for _, f := range flashes {
		<div
			class={ "alert", "alert-" + alertTag(f.Tag) }
			role="alert"
			x-data="autoDismiss(6000)"
			x-show="visible"
			x-transition.opacity.duration.300ms
		>
			{ f.Text }
			<button type="button" class="alert-close" aria-label="Close" x-on:click="visible = false">&times;</button>
		</div>
	}
}

// toastContainer renders the fixed-position stack that
// Alpine.store('toasts') (see /static/app.js) and the server's HX-Trigger
// "toast" event (see web/htmx.go's TriggerToast) push messages into, for
// transient feedback on htmx-driven actions that don't re-render the page.
templ toastContainer() {
	<div class="toast-container" x-data aria-live="polite">
		<template x-for="t in $store.toasts.items" x-bind:key="t.id">
			<div x-bind:class="'toast toast-' + t.tag" x-text="t.text" x-on:click="$store.toasts.remove(t.id)"></div>
		</template>
	</div>
}

func alertTag(tag string) string {
	switch tag {
	case "success", "danger", "warning", "info":
		return tag
	case "error":
		return "danger"
	default:
		return "secondary"
	}
}
