// Package layout provides the shared page chrome (sidebar/topbar/flash
// messages) for every web UI page, mirroring web_ui/templates/web_ui/base.html.
package layout

import (
	"controlplane/internal/notification"
	"controlplane/internal/session"
)

// NavUser is the current-user view the layout needs to render the sidebar
// and topbar, decoupled from the auth package to avoid an import cycle with
// the webui package (which imports views/pages, which imports this package).
type NavUser struct {
	LoggedIn  bool
	Email     string
	IsStaff   bool
	Modules   map[string]bool
	CSRFToken string
}

// HasModule reports whether the current user's effective group permissions
// grant access to module (one of the auth.Module* keys).
func (u NavUser) HasModule(module string) bool {
	return u.Modules[module]
}

templ Base(title string, activeNav string, user NavUser, flashes []session.Flash) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · Control Plane</title>
			<script>
				// Applied before first paint (blocking, no defer) so the page never
				// flashes the wrong theme. Mirrors the persistence logic in
				// /static/theme.js's toggle handler.
				(function() {
					try {
						var stored = localStorage.getItem("cp-theme");
						var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
						if (dark) document.documentElement.classList.add("dark");
					} catch (e) {}
				})();
			</script>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
			<link href="/static/app.css" rel="stylesheet"/>
			<script src="/static/theme.js" defer></script>
		</head>
		<body>
			if user.LoggedIn {
				<div class="app-shell">
					@sidebar(activeNav, user)
					<div class="content">
						@topbar(user)
						<main class="page">
							@Flashes(flashes)
							{ children... }
						</main>
					</div>
				</div>
			} else {
				<main class="auth-shell">
					@Flashes(flashes)
					{ children... }
				</main>
			}
		</body>
	</html>
}

templ sidebar(activeNav string, user NavUser) {
	<div class="sidebar">
		<a href="/dashboard/" class="brand">Control Plane</a>
		<nav>
			<ul>
				@navLink(activeNav, "dashboard", "/dashboard/", "bi-speedometer2", "Dashboard")
				if user.HasModule("applications") {
					@navLink(activeNav, "applications", "/applications/", "bi-grid-3x3-gap", "Applications")
				}
				if user.HasModule("environments") {
					@navLink(activeNav, "environments", "/environments/", "bi-layers", "Environments")
				}
				if user.HasModule("configs") {
					@navLink(activeNav, "configs", "/configs/", "bi-sliders", "Configs & Secrets")
				}
				if user.HasModule("flags") {
					@navLink(activeNav, "flags", "/flags/", "bi-toggle-on", "Feature Flags")
				}
				if notification.Enabled {
					@navLink(activeNav, "notifications", "/notifications/", "bi-bell", "Notifications")
				}
			</ul>
		</nav>
		if user.HasModule("users") || user.HasModule("groups") || user.HasModule("service_clients") || user.HasModule("oauth_providers") || user.HasModule("policies") {
			<details class="sidebar-group" open>
				<summary>Identity &amp; Access</summary>
				<nav>
					<ul>
						if user.HasModule("users") {
							@navLink(activeNav, "users", "/users/", "bi-people", "Users")
						}
						if user.HasModule("groups") {
							@navLink(activeNav, "groups", "/groups/", "bi-diagram-3", "Groups")
						}
						if user.HasModule("service_clients") {
							@navLink(activeNav, "clients", "/clients/", "bi-hdd-network", "Service Clients")
						}
						if user.HasModule("oauth_providers") {
							@navLink(activeNav, "oauth_providers", "/oauth/providers/", "bi-shield-lock", "OAuth Providers")
						}
						if user.HasModule("policies") {
							@navLink(activeNav, "policies", "/policies/", "bi-file-earmark-lock", "Policies")
						}
					</ul>
				</nav>
			</details>
		}
		if notification.Enabled && user.HasModule("notification_settings") {
			<nav>
				<ul>
					@navLink(activeNav, "notification_settings", "/notification-settings/", "bi-bell", "Notification Settings")
				</ul>
			</nav>
		}
		if user.HasModule("activity_log") {
			<nav>
				<ul>
					@navLink(activeNav, "activity", "/activity/", "bi-clock-history", "Activity Log")
				</ul>
			</nav>
		}
	</div>
}

templ navLink(activeNav, key, href, icon, label string) {
	<li>
		if activeNav == key {
			<a href={ templ.URL(href) } class="active" aria-current="page">
				<i class={ "bi", icon }></i>{ label }
			</a>
		} else {
			<a href={ templ.URL(href) }>
				<i class={ "bi", icon }></i>{ label }
			</a>
		}
	</li>
}

templ topbar(user NavUser) {
	<div class="topbar">
		<span class="user-email" title={ user.Email }>{ user.Email }</span>
		<button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
			<i class="bi bi-moon-stars"></i>
			<i class="bi bi-sun"></i>
		</button>
		<a role="button" class="btn-sm outline secondary" href="/password/change/">Change Password</a>
		<form method="post" action="/logout/" class="m-0">
			<input type="hidden" name="csrf_token" value={ user.CSRFToken }/>
			<button class="btn-sm btn-danger outline" type="submit">Logout</button>
		</form>
	</div>
}

templ Flashes(flashes []session.Flash) {
	for _, f := range flashes {
		<div class={ "alert", "alert-" + alertTag(f.Tag) } role="alert">
			{ f.Text }
			<button type="button" class="alert-close" aria-label="Close" onclick="this.closest('.alert').remove()">&times;</button>
		</div>
	}
}

func alertTag(tag string) string {
	switch tag {
	case "success", "danger", "warning", "info":
		return tag
	case "error":
		return "danger"
	default:
		return "secondary"
	}
}
