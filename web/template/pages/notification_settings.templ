package pages

import "controlplane/internal/session"
import "controlplane/web/template/layout"

type NotificationSettingRow struct {
	Channel    string
	Label      string
	Configured bool
	IsActive   bool
}

type NotificationSettingsListData struct {
	Rows      []NotificationSettingRow
	CSRFToken string
}

templ NotificationSettingsList(flashes []session.Flash, user layout.NavUser, data NotificationSettingsListData) {
	@layout.Base("Notification Settings", "notification_settings", user, flashes) {
		<h2>Notification Settings</h2>
		<article class="card">
			<table>
				<thead><tr><th>Channel</th><th>Credentials</th><th>Status</th><th class="actions">Actions</th></tr></thead>
				<tbody>
					for _, row := range data.Rows {
						<tr>
							<td>{ row.Label }</td>
							<td>
								if row.Configured {
									<span class="badge badge-success">Configured</span>
								} else {
									<span class="badge badge-secondary">Not configured</span>
								}
							</td>
							<td>
								if row.IsActive {
									<span class="badge badge-success">Active</span>
								} else {
									<span class="badge badge-secondary">Inactive</span>
								}
							</td>
							<td class="actions">
								<a role="button" class="btn-sm outline secondary" href={ templ.URL("/notification-settings/" + row.Channel + "/edit/") }>Edit</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</article>
	}
}

type NotificationSettingFormData struct {
	CSRFToken  string
	Channel    string
	Label      string
	IsActive   bool
	Configured bool
	Error      string

	// Config (JSON) - used for every channel except "email", which gets
	// structured fields below instead (see EmailFrom, EmailHost, etc.).
	Config string

	// Email-specific structured fields, populated only when Channel == "email".
	EmailHost     string
	EmailPort     string
	EmailFrom     string
	EmailFromName string
	EmailTLSMode  string
	EmailUsername string
}

templ NotificationSettingForm(flashes []session.Flash, user layout.NavUser, data NotificationSettingFormData) {
	@layout.Base("Edit "+data.Label+" Settings", "notification_settings", user, flashes) {
		<h2>Edit { data.Label } Settings</h2>
		<article class="form-card-lg">
			if data.Error != "" {
				<div class="alert alert-danger">{ data.Error }</div>
			}
			<form method="post" action={ templ.URL("/notification-settings/" + data.Channel + "/edit/") }>
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				if data.Channel == "email" {
					<label for="host">
						Host
						<input type="text" id="host" name="host" value={ data.EmailHost } placeholder="smtp.example.com"/>
					</label>
					<label for="port">
						Port
						<input type="number" id="port" name="port" value={ data.EmailPort } placeholder="587"/>
					</label>
					<label for="from">
						From address
						<input type="email" id="from" name="from" value={ data.EmailFrom } placeholder="noreply@example.com"/>
					</label>
					<label for="from_name">
						From name
						<input type="text" id="from_name" name="from_name" value={ data.EmailFromName } placeholder="Example"/>
					</label>
					<label for="tls_mode">
						TLS mode
						<select id="tls_mode" name="tls_mode">
							<option value="none" selected?={ data.EmailTLSMode == "none" }>None</option>
							<option value="starttls" selected?={ data.EmailTLSMode == "starttls" }>STARTTLS</option>
							<option value="tls" selected?={ data.EmailTLSMode == "tls" }>TLS</option>
						</select>
					</label>
					<label for="username">
						Username
						<input type="text" id="username" name="username" value={ data.EmailUsername } placeholder="smtp username"/>
					</label>
					<label for="password">
						Password
						<input type="password" id="password" name="password" placeholder="smtp password"/>
						if data.Configured {
							<small>Leave username and password both blank to keep the current credentials.</small>
						}
					</label>
				} else {
					<label for="config">
						Config (JSON)
						<textarea id="config" name="config" rows="4">{ data.Config }</textarea>
						<small>Provider-specific, non-secret settings (e.g. sender address), as a JSON object.</small>
					</label>
					<label for="credentials">
						Credentials
						<input type="password" id="credentials" name="credentials" placeholder="provider API key"/>
						if data.Configured {
							<small>Leave blank to keep the current credentials.</small>
						}
					</label>
				}
				<label for="is_active">
					if data.IsActive {
						<input type="checkbox" id="is_active" name="is_active" checked/>
					} else {
						<input type="checkbox" id="is_active" name="is_active"/>
					}
					Active
				</label>
				<div class="form-actions">
					<button type="submit">Save</button>
					<a role="button" class="secondary outline" href="/notification-settings/">Cancel</a>
				</div>
			</form>
		</article>
	}
}
