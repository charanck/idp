package pages

import "controlplane/internal/session"
import configmodel "controlplane/internal/model/config"
import "controlplane/web/template/layout"

type NotificationRow struct {
	ID              string
	ApplicationName string
	Channel         string
	Recipient       string
	Status          string
	Attempt         int
	Provider        string
	Error           string
	CreatedAt       string
	UpdatedAt       string
	DetailURL       string
}

type NotificationListData struct {
	Notifications  []NotificationRow
	Applications   []configmodel.Application
	CurrentAppID   string
	CurrentChannel string
	CurrentStatus  string
	Page           int
	NumPages       int
	HasPrev        bool
	HasNext        bool
	PrevNum        int
	NextNum        int
	Window         []int
	ExtraQuery     string
}

templ NotificationList(flashes []session.Flash, user layout.NavUser, data NotificationListData) {
	@layout.Base("Notifications", "notifications", user, flashes) {
		<h2>Notifications</h2>
		<form method="get" class="filter-bar">
			<div>
				<label for="application_id">Application</label>
				<select id="application_id" name="application_id">
					<option value="">All applications</option>
					for _, app := range data.Applications {
						if app.ID.String() == data.CurrentAppID {
							<option value={ app.ID.String() } selected>{ app.Name }</option>
						} else {
							<option value={ app.ID.String() }>{ app.Name }</option>
						}
					}
				</select>
			</div>
			<div>
				<label for="channel">Channel</label>
				<select id="channel" name="channel">
					<option value="">All channels</option>
					for _, ch := range []string{"email", "sms", "inapp"} {
						if ch == data.CurrentChannel {
							<option value={ ch } selected>{ ch }</option>
						} else {
							<option value={ ch }>{ ch }</option>
						}
					}
				</select>
			</div>
			<div>
				<label for="status">Status</label>
				<select id="status" name="status">
					<option value="">All statuses</option>
					for _, st := range []string{"queued", "processing", "retrying", "sent", "failed"} {
						if st == data.CurrentStatus {
							<option value={ st } selected>{ st }</option>
						} else {
							<option value={ st }>{ st }</option>
						}
					}
				</select>
			</div>
			<button class="btn-sm secondary" type="submit">Filter</button>
			<button class="btn-sm secondary" type="button" onclick="window.location.reload()">Refresh</button>
		</form>
		<article class="card">
			<table>
				<thead>
					<tr>
						<th>Application</th>
						<th>Channel</th>
						<th>Recipient</th>
						<th>Status</th>
						<th>Attempt</th>
						<th>Provider</th>
						<th>Error</th>
						<th>Created</th>
						<th>Updated</th>
						<th class="actions">Actions</th>
					</tr>
				</thead>
				<tbody>
					if len(data.Notifications) == 0 {
						<tr><td colspan="10">No notifications recorded.</td></tr>
					}
					for _, n := range data.Notifications {
						<tr>
							<td>{ n.ApplicationName }</td>
							<td>{ n.Channel }</td>
							<td>{ n.Recipient }</td>
							<td>
								<span class={ "badge", statusBadgeClass(n.Status) }>{ n.Status }</span>
							</td>
							<td>{ n.Attempt }</td>
							<td>{ n.Provider }</td>
							<td>{ n.Error }</td>
							<td>{ n.CreatedAt }</td>
							<td>{ n.UpdatedAt }</td>
							<td class="actions">
								<a role="button" class="btn-sm outline secondary" href={ templ.URL(n.DetailURL) }>View</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</article>
		@PaginationNav("/notifications/", data.ExtraQuery, data.Page, data.NumPages, data.HasPrev, data.HasNext, data.PrevNum, data.NextNum, data.Window)
		<script>
			setTimeout(function() { window.location.reload(); }, 60000);
		</script>
	}
}

func statusBadgeClass(status string) string {
	switch status {
	case "sent":
		return "badge-success"
	case "failed":
		return "badge-danger"
	case "retrying":
		return "badge-warning"
	default:
		return "badge-secondary"
	}
}

type NotificationDetailData struct {
	ID                string
	ApplicationName   string
	Channel           string
	Status            string
	Attempt           int
	Provider          string
	ProviderMessageID string
	IdempotencyKey    string
	Error             string
	Recipient         string
	Content           string
	ReadAt            string
	CreatedAt         string
	UpdatedAt         string
}

templ NotificationDetail(flashes []session.Flash, user layout.NavUser, data NotificationDetailData) {
	@layout.Base("Notification Details", "notifications", user, flashes) {
		<article class="form-card-xl">
			<div class="toolbar">
				<div>
					<h3 class="mb-1">{ data.ApplicationName } &middot; { data.Channel }</h3>
					<p class="stat-label m-0">Notification delivery details.</p>
				</div>
				<span class={ "badge", statusBadgeClass(data.Status) }>{ data.Status }</span>
			</div>
			<table>
				<tbody>
					<tr><th>ID</th><td><code>{ data.ID }</code></td></tr>
					<tr><th>Application</th><td>{ data.ApplicationName }</td></tr>
					<tr><th>Channel</th><td>{ data.Channel }</td></tr>
					<tr><th>Status</th><td><span class={ "badge", statusBadgeClass(data.Status) }>{ data.Status }</span></td></tr>
					<tr><th>Attempt</th><td>{ data.Attempt }</td></tr>
					<tr><th>Provider</th><td>{ data.Provider }</td></tr>
					<tr><th>Provider Message ID</th><td><code>{ data.ProviderMessageID }</code></td></tr>
					<tr><th>Idempotency Key</th><td><code>{ data.IdempotencyKey }</code></td></tr>
					if data.Error != "" {
						<tr><th>Error</th><td>{ data.Error }</td></tr>
					}
					if data.ReadAt != "" {
						<tr><th>Read At</th><td>{ data.ReadAt }</td></tr>
					}
					<tr><th>Created</th><td>{ data.CreatedAt }</td></tr>
					<tr><th>Updated</th><td>{ data.UpdatedAt }</td></tr>
					<tr><th>Recipient</th><td><pre>{ data.Recipient }</pre></td></tr>
					<tr><th>Content</th><td><pre>{ data.Content }</pre></td></tr>
				</tbody>
			</table>
			<div class="toolbar">
				<a role="button" class="secondary outline" href="/notifications/">Back to Notifications</a>
			</div>
		</article>
	}
}
