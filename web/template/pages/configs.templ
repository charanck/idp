package pages

import "encoding/json"
import configmodel "controlplane/internal/model/config"
import "controlplane/internal/session"
import "controlplane/web/template/layout"

// ConfigGroup mirrors configs_list.html's grouping: one row per
// (application, key, is_secret, type), holding every environment's entry for
// that key so the table can show all environments side by side.
type ConfigGroup struct {
	ApplicationID   string
	ApplicationName string
	Key             string
	IsSecret        bool
	Type            string
	Entries         []ConfigGroupEntry
}

type ConfigGroupEntry struct {
	ID              string
	EnvironmentName string
	DisplayValue    string
}

type ConfigsListData struct {
	Groups                []ConfigGroup
	Applications          []configmodel.Application
	EnvironmentsByAppJSON string
	CurrentAppID          string
	CurrentEnvID          string
	CurrentQ              string
	CurrentSecret         string
	Page                  int
	NumPages              int
	HasPrev               bool
	HasNext               bool
	PrevNum               int
	NextNum               int
	Window                []int
	ExtraQuery            string
}

templ ConfigsList(flashes []session.Flash, user layout.NavUser, data ConfigsListData) {
	@layout.Base("Configs & Secrets", "configs", user, flashes) {
		<div class="toolbar">
			<h2>Configs &amp; Secrets</h2>
			<a role="button" href="/configs/create/"><i class="bi bi-plus-lg"></i> New Config</a>
		</div>
		<form method="get" class="filter-bar">
			<div>
				<label for="filter_application">Application</label>
				<select id="filter_application" name="application_id">
					<option value="">All applications</option>
					for _, app := range data.Applications {
						if app.ID.String() == data.CurrentAppID {
							<option value={ app.ID.String() } selected>{ app.Name }</option>
						} else {
							<option value={ app.ID.String() }>{ app.Name }</option>
						}
					}
				</select>
			</div>
			<div>
				<label for="filter_environment">Environment</label>
				<select id="filter_environment" name="environment_id" data-selected-env-id={ data.CurrentEnvID }>
					<option value="">All environments</option>
				</select>
			</div>
			<div>
				<label for="secret">Type</label>
				<select id="secret" name="secret">
					<option value="" selected?={ data.CurrentSecret == "" }>All</option>
					<option value="secret" selected?={ data.CurrentSecret == "secret" }>Secrets only</option>
					<option value="config" selected?={ data.CurrentSecret == "config" }>Configs only</option>
				</select>
			</div>
			<div>
				<label for="q">Key</label>
				<input type="text" id="q" name="q" placeholder="Key" value={ data.CurrentQ }/>
			</div>
			<button type="submit" class="btn-sm secondary">Filter</button>
		</form>
		if len(data.Groups) == 0 {
			<div class="alert alert-secondary">No configs found.</div>
		}
		for _, group := range data.Groups {
			<article class="card">
				<header>
					<strong>{ group.ApplicationName }</strong> / { group.Key }
					if group.IsSecret {
						<span class="badge badge-warning">Secret</span>
					} else {
						<span class="badge badge-secondary">Config</span>
					}
					<span class="badge badge-info">{ group.Type }</span>
				</header>
				<table>
					<tbody>
						for _, entry := range group.Entries {
							<tr>
								<td class="col-env">{ entry.EnvironmentName }</td>
								<td class="truncate max-w-xs">
									if group.IsSecret {
										<code>••••••••</code>
									} else {
										<code>{ entry.DisplayValue }</code>
									}
								</td>
								<td class="actions">
									<a role="button" class="btn-sm outline secondary" href={ templ.URL("/configs/" + entry.ID + "/history/") }>History</a>
									<a role="button" class="btn-sm outline secondary" href={ templ.URL("/configs/" + entry.ID + "/clone/") }>Clone</a>
									<a role="button" class="btn-sm outline secondary" href={ templ.URL("/configs/" + entry.ID + "/edit/") }>Edit</a>
									<a role="button" class="btn-sm btn-danger outline" href={ templ.URL("/configs/" + entry.ID + "/delete/") }>Delete</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</article>
		}
		@PaginationNav("/configs/", data.ExtraQuery, data.Page, data.NumPages, data.HasPrev, data.HasNext, data.PrevNum, data.NextNum, data.Window)
		@templ.JSONScript("environments-by-application", json.RawMessage(data.EnvironmentsByAppJSON))
		<script>
			(function() {
				var envByApp = JSON.parse(document.getElementById('environments-by-application').textContent || '{}');
				var appSelect = document.getElementById('filter_application');
				var envSelect = document.getElementById('filter_environment');
				var selectedEnvId = envSelect.dataset.selectedEnvId || '';

				function repopulate() {
					var envs = envByApp[appSelect.value] || [];
					envSelect.innerHTML = '<option value="">All environments</option>';
					envs.forEach(function(env) {
						var opt = document.createElement('option');
						opt.value = env.id;
						opt.textContent = env.name;
						if (env.id === selectedEnvId) { opt.selected = true; }
						envSelect.appendChild(opt);
					});
				}
				appSelect.addEventListener('change', function() { selectedEnvId = ''; repopulate(); });
				repopulate();
			})();
		</script>
	}
}

type ConfigFormData struct {
	CSRFToken             string
	Applications          []configmodel.Application
	EnvironmentsByAppJSON string
	ApplicationID         string
	EnvironmentID         string
	Key                   string
	Value                 string
	Type                  string
	IsSecret              bool
	Error                 string
	Action                string
	Title                 string
	ShowSubmitAction      bool // create_single vs create_all_env, only on create/clone
	IsEdit                bool
}

templ ConfigForm(flashes []session.Flash, user layout.NavUser, data ConfigFormData) {
	@layout.Base(data.Title, "configs", user, flashes) {
		<h2>{ data.Title }</h2>
		<article class="form-card-lg">
			if data.Error != "" {
				<div class="alert alert-danger">{ data.Error }</div>
			}
			<form method="post" action={ templ.URL(data.Action) }>
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<label for="application">
					Application
					<select id="application" name="application_id" required>
						<option value="">Select an application</option>
						for _, app := range data.Applications {
							if app.ID.String() == data.ApplicationID {
								<option value={ app.ID.String() } selected>{ app.Name }</option>
							} else {
								<option value={ app.ID.String() }>{ app.Name }</option>
							}
						}
					</select>
				</label>
				<label for="environment">
					Environment
					<select id="environment" name="environment_id" required data-selected-env-id={ data.EnvironmentID }></select>
				</label>
				<label for="key">
					Key
					<input type="text" id="key" name="key" value={ data.Key } required/>
				</label>
				<label for="value">
					Value
					<textarea id="value" name="value" rows="3">{ data.Value }</textarea>
				</label>
				<label for="type">
					Type
					<select id="type" name="type">
						@typeOption(data.Type, configmodel.TypeString, "String")
						@typeOption(data.Type, configmodel.TypeBoolean, "Boolean")
						@typeOption(data.Type, configmodel.TypeNumber, "Number")
						@typeOption(data.Type, configmodel.TypeObject, "Object")
						@typeOption(data.Type, configmodel.TypeArray, "Array")
					</select>
				</label>
				<label for="is_secret">
					if data.IsSecret {
						<input type="checkbox" id="is_secret" name="is_secret" checked/>
					} else {
						<input type="checkbox" id="is_secret" name="is_secret"/>
					}
					This is a secret
				</label>
				if data.ShowSubmitAction {
					<fieldset>
						<label for="submit_single">
							<input type="radio" name="submit_action" id="submit_single" value="create_single" checked/>
							Save to selected environment only
						</label>
						<label for="submit_all">
							<input type="radio" name="submit_action" id="submit_all" value="create_all_env"/>
							Save to all environments of this application
						</label>
					</fieldset>
				}
				<div class="form-actions">
					<button type="submit">Save</button>
					<a role="button" class="secondary outline" href="/configs/">Cancel</a>
				</div>
			</form>
			@templ.JSONScript("environments-by-application", json.RawMessage(data.EnvironmentsByAppJSON))
			<script>
				(function() {
					var envByApp = JSON.parse(document.getElementById('environments-by-application').textContent || '{}');
					var appSelect = document.getElementById('application');
					var envSelect = document.getElementById('environment');
					var selectedEnvId = envSelect.dataset.selectedEnvId || '';

					function repopulate() {
						var envs = envByApp[appSelect.value] || [];
						envSelect.innerHTML = '';
						envs.forEach(function(env) {
							var opt = document.createElement('option');
							opt.value = env.id;
							opt.textContent = env.name;
							if (env.id === selectedEnvId) { opt.selected = true; }
							envSelect.appendChild(opt);
						});
					}
					appSelect.addEventListener('change', function() { selectedEnvId = ''; repopulate(); });
					repopulate();
				})();
			</script>
		</article>
	}
}

templ typeOption(current, value, label string) {
	if current == value {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

type ConfigHistoryData struct {
	ConfigID    string
	Application string
	Environment string
	Key         string
	Versions    []ConfigHistoryVersion
	CSRFToken   string
}

type ConfigHistoryVersion struct {
	Version   string
	Action    string
	ChangedBy string
	CreatedAt string
}

templ ConfigHistory(flashes []session.Flash, user layout.NavUser, data ConfigHistoryData) {
	@layout.Base("Config History", "configs", user, flashes) {
		<h2>{ data.Application } / { data.Environment } / { data.Key }</h2>
		<p>Version history</p>
		<article class="card">
			<table>
				<thead><tr><th>Version</th><th>Action</th><th>Changed By</th><th>When</th><th class="actions">Actions</th></tr></thead>
				<tbody>
					if len(data.Versions) == 0 {
						<tr><td colspan="5">No history yet.</td></tr>
					}
					for _, v := range data.Versions {
						<tr>
							<td>{ v.Version }</td>
							<td>{ v.Action }</td>
							<td>{ v.ChangedBy }</td>
							<td>{ v.CreatedAt }</td>
							<td class="actions">
								<form method="post" action={ templ.URL("/configs/" + data.ConfigID + "/rollback/" + v.Version + "/") }>
									<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
									<button type="submit" class="btn-sm outline" onclick="return confirm('Roll back to this version?')">Rollback</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</article>
		<a role="button" class="secondary outline" href="/configs/">Back to Configs</a>
	}
}
