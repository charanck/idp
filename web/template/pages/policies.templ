package pages

import "controlplane/internal/session"
import "controlplane/web/template/layout"

type PoliciesFormData struct {
	CSRFToken                      string
	SelfRegistrationAllowedDomains string
	Error                          string
}

templ PoliciesForm(flashes []session.Flash, user layout.NavUser, data PoliciesFormData) {
	@layout.Base("Policies", "policies", user, flashes) {
		<h2>Policies</h2>
		<article class="form-card-lg">
			if data.Error != "" {
				<div class="alert alert-danger">{ data.Error }</div>
			}
			<form method="post" action="/policies/">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<label for="self_registration_allowed_domains">
					Self-Registration Allowed Domains
					<input
						type="text"
						id="self_registration_allowed_domains"
						name="self_registration_allowed_domains"
						placeholder="example.com, another.com"
						value={ data.SelfRegistrationAllowedDomains }
					/>
					<small>Comma-separated list of email domains allowed to self-register. Leave blank to allow any domain.</small>
				</label>
				<div class="form-actions">
					<button type="submit">Save</button>
				</div>
			</form>
		</article>
	}
}
