package pages

import authmodel "controlplane/internal/model/auth"
import "controlplane/internal/session"
import "controlplane/web/template/layout"

type OAuthProvidersListData struct {
	Providers     []authmodel.OAuthProvider
	CurrentQ      string
	CurrentStatus string
	Page          int
	NumPages      int
	HasPrev       bool
	HasNext       bool
	PrevNum       int
	NextNum       int
	Window        []int
	ExtraQuery    string
	CSRFToken     string
}

templ OAuthProvidersList(flashes []session.Flash, user layout.NavUser, data OAuthProvidersListData) {
	@layout.Base("OAuth Providers", "oauth_providers", user, flashes) {
		<div class="toolbar">
			<h2>OAuth Providers <span class="badge badge-alpha">Alpha</span></h2>
			<a role="button" href="/oauth/providers/create/"><i class="bi bi-plus-lg"></i> New Provider</a>
		</div>
		<form
			method="get"
			class="filter-bar"
			hx-get="/oauth/providers/"
			hx-trigger="change, keyup[key=='Enter'] from:#q, keyup changed delay:400ms from:#q"
			hx-target="#oauth-providers-results"
			hx-select="#oauth-providers-results"
			hx-swap="outerHTML"
			hx-push-url="true"
			hx-indicator="#oauth-providers-loading"
		>
			<div>
				<label for="q">Search</label>
				<input type="text" id="q" name="q" placeholder="Provider name" value={ data.CurrentQ } autocomplete="off"/>
			</div>
			<div>
				<label for="status">Status</label>
				<select id="status" name="status">
					<option value="" selected?={ data.CurrentStatus == "" }>All</option>
					<option value="active" selected?={ data.CurrentStatus == "active" }>Active</option>
					<option value="inactive" selected?={ data.CurrentStatus == "inactive" }>Inactive</option>
				</select>
			</div>
			<button type="submit" class="btn-sm secondary">Filter</button>
			<span id="oauth-providers-loading" class="htmx-indicator"><i class="bi bi-arrow-repeat"></i> Loading…</span>
		</form>
		<div id="oauth-providers-results">
			<article class="card">
				<table>
					<thead><tr><th>Name</th><th>Client ID</th><th>Status</th><th class="actions">Actions</th></tr></thead>
					<tbody>
						if len(data.Providers) == 0 {
							<tr><td colspan="4">No OAuth providers found.</td></tr>
						}
						for _, p := range data.Providers {
							@OAuthProviderRow(data.CSRFToken, p)
						}
					</tbody>
				</table>
			</article>
			@PaginationNav("/oauth/providers/", data.ExtraQuery, data.Page, data.NumPages, data.HasPrev, data.HasNext, data.PrevNum, data.NextNum, data.Window)
		</div>
	}
}

// OAuthProviderRow is rendered both as part of the full list and, on its
// own, as the htmx fragment a toggle action swaps back in (see
// OAuthProviderHandler.Toggle) - keeping a single source of truth for the
// row markup.
templ OAuthProviderRow(csrfToken string, p authmodel.OAuthProvider) {
	<tr id={ "oauth-provider-row-" + p.ID.String() }>
		<td>{ p.Name }</td>
		<td class="truncate max-w-[16rem]" title={ p.ClientID }><code>{ p.ClientID }</code></td>
		<td>
			if p.IsActive {
				<span class="badge badge-success">Active</span>
			} else {
				<span class="badge badge-secondary">Inactive</span>
			}
		</td>
		<td class="actions">
			<form
				method="post"
				action={ templ.URL("/oauth/providers/" + p.ID.String() + "/toggle/") }
				hx-post={ "/oauth/providers/" + p.ID.String() + "/toggle/" }
				hx-target={ "#oauth-provider-row-" + p.ID.String() }
				hx-swap="outerHTML"
			>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<button class="btn-sm outline secondary" type="submit">Toggle</button>
			</form>
			<a role="button" class="btn-sm outline secondary" href={ templ.URL("/oauth/providers/" + p.ID.String() + "/edit/") }>Edit</a>
			<a
				role="button"
				class="btn-sm btn-danger outline"
				href={ templ.URL("/oauth/providers/" + p.ID.String() + "/delete/") }
				hx-post={ "/oauth/providers/" + p.ID.String() + "/delete/" }
				hx-vals={ "{\"csrf_token\":\"" + csrfToken + "\"}" }
				hx-confirm="Delete this OAuth provider?"
				hx-target={ "#oauth-provider-row-" + p.ID.String() }
				hx-swap="outerHTML swap:200ms"
			>Delete</a>
		</td>
	</tr>
}

type OAuthProviderFormData struct {
	CSRFToken        string
	Title            string
	Action           string
	Name             string
	ClientID         string
	ClientSecret     string
	AuthorizationURL string
	TokenURL         string
	UserinfoURL      string
	Scope            string
	AutoCreateUsers  bool
	IsActive         bool
	Error            string
	IsEdit           bool
}

templ OAuthProviderForm(flashes []session.Flash, user layout.NavUser, data OAuthProviderFormData) {
	@layout.Base(data.Title, "oauth_providers", user, flashes) {
		<h2>{ data.Title }</h2>
		<article class="form-card-lg">
			if data.Error != "" {
				<div class="alert alert-danger">{ data.Error }</div>
			}
			<form method="post" action={ templ.URL(data.Action) }>
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<label for="name">
					Name
					<input type="text" id="name" name="name" placeholder="Google" value={ data.Name } required/>
				</label>
				<label for="client_id">
					Client ID
					<input type="text" id="client_id" name="client_id" placeholder="your-client-id" value={ data.ClientID } required/>
				</label>
				<label for="client_secret">
					Client Secret
					<input type="password" id="client_secret" name="client_secret" placeholder="your-client-secret" value={ data.ClientSecret }/>
					if data.IsEdit {
						<small>Leave blank to keep the current secret.</small>
					}
				</label>
				<label for="authorization_url">
					Authorization URL
					<input type="url" id="authorization_url" name="authorization_url" placeholder="https://provider.com/oauth/authorize" value={ data.AuthorizationURL } required/>
				</label>
				<label for="token_url">
					Token URL
					<input type="url" id="token_url" name="token_url" placeholder="https://provider.com/oauth/token" value={ data.TokenURL } required/>
				</label>
				<label for="userinfo_url">
					Userinfo URL
					<input type="url" id="userinfo_url" name="userinfo_url" placeholder="https://provider.com/oauth/userinfo" value={ data.UserinfoURL }/>
				</label>
				<label for="scope">
					Scope
					<input type="text" id="scope" name="scope" placeholder="openid email profile" value={ data.Scope }/>
				</label>
				<label for="auto_create_users">
					if data.AutoCreateUsers {
						<input type="checkbox" id="auto_create_users" name="auto_create_users" checked/>
					} else {
						<input type="checkbox" id="auto_create_users" name="auto_create_users"/>
					}
					Auto-create users on first login
				</label>
				<label for="is_active">
					if data.IsActive {
						<input type="checkbox" id="is_active" name="is_active" checked/>
					} else {
						<input type="checkbox" id="is_active" name="is_active"/>
					}
					Active
				</label>
				<div class="form-actions">
					<button type="submit">Save</button>
					<a role="button" class="secondary outline" href="/oauth/providers/">Cancel</a>
				</div>
			</form>
		</article>
	}
}
