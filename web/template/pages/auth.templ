package pages

import "controlplane/internal/session"
import "controlplane/web/template/layout"

// LoginData carries the login form's submitted values + CSRF token; there is
// no logged-in NavUser yet, so the layout renders its unauthenticated shell.
type LoginData struct {
	CSRFToken          string
	Email              string
	Error              string
	OAuthProviders     []LoginOAuthProvider
	ProductName        string
	LogoURL            string
	AccentColor        string
	BackgroundImageURL string
}

type LoginOAuthProvider struct {
	ID   string
	Name string
}

templ Login(flashes []session.Flash, data LoginData) {
	@layout.Base("Log in", "", layout.NavUser{ProductName: data.ProductName, LogoURL: data.LogoURL, AccentColor: data.AccentColor, BackgroundImageURL: data.BackgroundImageURL}, flashes) {
		<article class="login-card">
			<div class="login-brand">
				if data.LogoURL != "" {
					<img src={ data.LogoURL } alt="" class="brand-logo"/>
				}
				<h4>
					if data.ProductName != "" {
						{ data.ProductName }
					} else {
						Control Plane
					}
				</h4>
				<p class="login-subtitle">Sign in to continue</p>
			</div>
			if data.Error != "" {
				<div class="alert alert-danger">{ data.Error }</div>
			}
			<form method="post" action="/login/" class="login-form">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<label for="email">
					Username or email
					<input type="email" id="email" name="username" value={ data.Email } required autofocus/>
				</label>
				<label for="password">
					Password
					<input type="password" id="password" name="password" required/>
				</label>
				<button type="submit" class="login-submit">Sign in</button>
			</form>
			if len(data.OAuthProviders) > 0 {
				<div class="login-divider"><span>or</span></div>
				<div class="login-oauth-list">
					for _, p := range data.OAuthProviders {
						<a role="button" class="secondary outline block mb-2" href={ templ.URL("/oauth/login/" + p.ID + "/") }>
							<i class="bi bi-box-arrow-in-right"></i> Continue with { p.Name }
						</a>
					}
				</div>
			}
		</article>
	}
}

type PasswordChangeData struct {
	CSRFToken  string
	ForceReset bool
	Errors     []string
}

templ PasswordChange(flashes []session.Flash, user layout.NavUser, data PasswordChangeData) {
	@layout.Base("Change Password", "", user, flashes) {
		<h2>Change Password</h2>
		<article class="form-card-sm">
			if data.ForceReset {
				<div class="alert alert-warning">You must change your password before continuing.</div>
			}
			for _, e := range data.Errors {
				<div class="alert alert-danger">{ e }</div>
			}
			@passwordChangeForm(data)
		</article>
	}
}

templ passwordChangeForm(data PasswordChangeData) {
	<form method="post" action="/password/change/">
		<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
		if !data.ForceReset {
			<label for="old_password">
				Current Password
				<input type="password" id="old_password" name="old_password" required/>
			</label>
		}
		<label for="new_password1">
			New Password
			<input type="password" id="new_password1" name="new_password1" required/>
		</label>
		<label for="new_password2">
			Confirm New Password
			<input type="password" id="new_password2" name="new_password2" required/>
		</label>
		<button type="submit">Change Password</button>
	</form>
}

// ProfileData drives the merged "My Profile" page: self-editable identity
// fields (username, first/last name - deliberately excludes email, which
// stays admin-only via UpdateUserAdmin) plus the password-change form.
type ProfileData struct {
	CSRFToken      string
	Username       string
	FirstName      string
	LastName       string
	Email          string
	ProfileError   string
	ProfileSuccess bool
	Password       PasswordChangeData
}

templ Profile(flashes []session.Flash, user layout.NavUser, data ProfileData) {
	@layout.Base("My Profile", "", user, flashes) {
		<h2>My Profile</h2>
		<article class="form-card-sm">
			<h3>Account Details</h3>
			if data.ProfileError != "" {
				<div class="alert alert-danger">{ data.ProfileError }</div>
			}
			if data.ProfileSuccess {
				<div class="alert alert-success">Your profile has been updated.</div>
			}
			<form method="post" action="/profile/">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<label for="email">
					Email
					<input type="email" id="email" value={ data.Email } disabled/>
				</label>
				<label for="username">
					Username
					<input type="text" id="username" name="username" value={ data.Username } required/>
				</label>
				<label for="first_name">
					First Name
					<input type="text" id="first_name" name="first_name" value={ data.FirstName }/>
				</label>
				<label for="last_name">
					Last Name
					<input type="text" id="last_name" name="last_name" value={ data.LastName }/>
				</label>
				<button type="submit">Save</button>
			</form>
		</article>
		<article class="form-card-sm">
			<h3>Change Password</h3>
			if data.Password.ForceReset {
				<div class="alert alert-warning">You must change your password before continuing.</div>
			}
			for _, e := range data.Password.Errors {
				<div class="alert alert-danger">{ e }</div>
			}
			@passwordChangeForm(data.Password)
		</article>
	}
}
