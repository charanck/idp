package pages

import "controlplane/internal/session"
import "controlplane/web/template/layout"
import "encoding/json"
import "controlplane/internal/config"

type FlagGroup struct {
	ApplicationID   string
	ApplicationName string
	Name            string
	Description     string
	Entries         []FlagGroupEntry
}

type FlagGroupEntry struct {
	ID              string
	EnvironmentName string
	IsEnabled       bool
}

type FlagsListData struct {
	Groups                []FlagGroup
	CSRFToken             string
	Applications          []config.Application
	EnvironmentsByAppJSON string
	CurrentAppID          string
	CurrentEnvID          string
	CurrentStatus         string
	Page                  int
	NumPages              int
	HasPrev               bool
	HasNext               bool
	PrevNum               int
	NextNum               int
	Window                []int
	ExtraQuery            string
}

templ FlagsList(flashes []session.Flash, user layout.NavUser, data FlagsListData) {
	@layout.Base("Feature Flags", "flags", user, flashes) {
		<div class="toolbar">
			<h2>Feature Flags</h2>
			<a role="button" href="/flags/create/"><i class="bi bi-plus-lg"></i> New Feature Flag</a>
		</div>
		<form method="get" class="filter-bar">
			<div>
				<label for="filter_application">Application</label>
				<select id="filter_application" name="application_id">
					<option value="">All applications</option>
					for _, app := range data.Applications {
						if app.ID.String() == data.CurrentAppID {
							<option value={ app.ID.String() } selected>{ app.Name }</option>
						} else {
							<option value={ app.ID.String() }>{ app.Name }</option>
						}
					}
				</select>
			</div>
			<div>
				<label for="filter_environment">Environment</label>
				<select id="filter_environment" name="environment_id" data-selected-env-id={ data.CurrentEnvID }>
					<option value="">All environments</option>
				</select>
			</div>
			<div>
				<label for="status">Status</label>
				<select id="status" name="status">
					<option value="" selected?={ data.CurrentStatus == "" }>All</option>
					<option value="enabled" selected?={ data.CurrentStatus == "enabled" }>Enabled</option>
					<option value="disabled" selected?={ data.CurrentStatus == "disabled" }>Disabled</option>
				</select>
			</div>
			<button type="submit" class="btn-sm secondary" style="width: auto;">Filter</button>
		</form>
		if len(data.Groups) == 0 {
			<div class="alert alert-secondary">No feature flags found.</div>
		}
		for _, group := range data.Groups {
			<article class="card">
				<header>
					<strong>{ group.ApplicationName }</strong> / { group.Name }
					if group.Description != "" {
						<div class="stat-label">{ group.Description }</div>
					}
				</header>
				<table>
					<tbody>
						for _, entry := range group.Entries {
							<tr>
								<td style="width: 160px;">{ entry.EnvironmentName }</td>
								<td>
									if entry.IsEnabled {
										<span class="badge badge-success">Enabled</span>
									} else {
										<span class="badge badge-secondary">Disabled</span>
									}
								</td>
								<td class="actions">
									<form method="post" action={ templ.URL("/flags/" + entry.ID + "/toggle/") }>
										<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
										<button class="btn-sm outline secondary" type="submit" style="width: auto;">Toggle</button>
									</form>
									<a role="button" class="btn-sm btn-danger outline" href={ templ.URL("/flags/" + entry.ID + "/delete/") }>Delete</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</article>
		}
		@PaginationNav("/flags/", data.ExtraQuery, data.Page, data.NumPages, data.HasPrev, data.HasNext, data.PrevNum, data.NextNum, data.Window)
		@templ.JSONScript("environments-by-application", json.RawMessage(data.EnvironmentsByAppJSON))
		<script>
			(function() {
				var envByApp = JSON.parse(document.getElementById('environments-by-application').textContent || '{}');
				var appSelect = document.getElementById('filter_application');
				var envSelect = document.getElementById('filter_environment');
				var selectedEnvId = envSelect.dataset.selectedEnvId || '';

				function repopulate() {
					var envs = envByApp[appSelect.value] || [];
					envSelect.innerHTML = '<option value="">All environments</option>';
					envs.forEach(function(env) {
						var opt = document.createElement('option');
						opt.value = env.id;
						opt.textContent = env.name;
						if (env.id === selectedEnvId) { opt.selected = true; }
						envSelect.appendChild(opt);
					});
				}
				appSelect.addEventListener('change', function() { selectedEnvId = ''; repopulate(); });
				repopulate();
			})();
		</script>
	}
}

// FlagFormData has no environment field: a feature flag is always created
// across every environment of the selected application (see
// FeatureFlagForm's docstring / flag_create's create_all_environments=True).
type FlagFormData struct {
	CSRFToken     string
	Applications  []config.Application
	ApplicationID string
	Name          string
	Description   string
	IsEnabled     bool
	Error         string
}

templ FlagForm(flashes []session.Flash, user layout.NavUser, data FlagFormData) {
	@layout.Base("New Feature Flag", "flags", user, flashes) {
		<h2>New Feature Flag</h2>
		<article style="max-width: 560px;">
			if data.Error != "" {
				<div class="alert alert-danger">{ data.Error }</div>
			}
			<form method="post" action="/flags/create/">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<label for="application">
					Application
					<select id="application" name="application_id" required>
						<option value="">Select an application</option>
						for _, app := range data.Applications {
							if app.ID.String() == data.ApplicationID {
								<option value={ app.ID.String() } selected>{ app.Name }</option>
							} else {
								<option value={ app.ID.String() }>{ app.Name }</option>
							}
						}
					</select>
				</label>
				<label for="name">
					Name
					<input type="text" id="name" name="name" value={ data.Name } required/>
				</label>
				<label for="description">
					Description
					<input type="text" id="description" name="description" value={ data.Description }/>
				</label>
				<label for="is_enabled">
					if data.IsEnabled {
						<input type="checkbox" id="is_enabled" name="is_enabled" checked/>
					} else {
						<input type="checkbox" id="is_enabled" name="is_enabled"/>
					}
					Enabled
				</label>
				<p class="stat-label">This flag will be created for every environment of the selected application.</p>
				<button type="submit" style="width: auto;">Save</button>
				<a role="button" class="secondary outline" style="width: auto; margin-left: 0.5rem;" href="/flags/">Cancel</a>
			</form>
		</article>
	}
}
