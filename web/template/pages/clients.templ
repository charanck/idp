package pages

import authmodel "controlplane/internal/model/auth"
import "controlplane/internal/session"
import "controlplane/web/template/layout"

type ClientsListData struct {
	Clients       []authmodel.ServiceClient
	CurrentQ      string
	CurrentStatus string
	Page          int
	NumPages      int
	HasPrev       bool
	HasNext       bool
	PrevNum       int
	NextNum       int
	Window        []int
	ExtraQuery    string
}

templ ClientsList(flashes []session.Flash, user layout.NavUser, data ClientsListData) {
	@layout.Base("Service Clients", "clients", user, flashes) {
		<div class="toolbar">
			<h2>Service Clients</h2>
			<a role="button" href="/clients/create/"><i class="bi bi-plus-lg"></i> New Client</a>
		</div>
		<form method="get" class="filter-bar">
			<div>
				<label for="q">Search</label>
				<input type="text" id="q" name="q" placeholder="Client name" value={ data.CurrentQ }/>
			</div>
			<div>
				<label for="status">Status</label>
				<select id="status" name="status">
					<option value="" selected?={ data.CurrentStatus == "" }>All</option>
					<option value="active" selected?={ data.CurrentStatus == "active" }>Active</option>
					<option value="inactive" selected?={ data.CurrentStatus == "inactive" }>Inactive</option>
				</select>
			</div>
			<button type="submit" class="btn-sm secondary">Filter</button>
		</form>
		<article class="card">
			<table>
				<thead><tr><th>Name</th><th>API Key ID</th><th>Status</th><th class="actions">Actions</th></tr></thead>
				<tbody>
					if len(data.Clients) == 0 {
						<tr><td colspan="4">No service clients found.</td></tr>
					}
					for _, client := range data.Clients {
						<tr>
							<td>{ client.Name }</td>
							<td><code>
								if client.APIKeyID != nil {
									{ *client.APIKeyID }
								} else {
									-
								}
							</code></td>
							<td>
								if client.IsActive {
									<span class="badge badge-success">Active</span>
								} else {
									<span class="badge badge-secondary">Inactive</span>
								}
							</td>
							<td class="actions">
								<a role="button" class="btn-sm outline secondary" href={ templ.URL("/clients/" + client.ID.String() + "/") }>View</a>
								<a role="button" class="btn-sm outline secondary" href={ templ.URL("/clients/" + client.ID.String() + "/edit/") }>Edit</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</article>
		@PaginationNav("/clients/", data.ExtraQuery, data.Page, data.NumPages, data.HasPrev, data.HasNext, data.PrevNum, data.NextNum, data.Window)
	}
}

type ClientFormData struct {
	CSRFToken string
	Name      string
	Error     string
}

templ ClientForm(flashes []session.Flash, user layout.NavUser, data ClientFormData) {
	@layout.Base("New Service Client", "clients", user, flashes) {
		<h2>New Service Client</h2>
		<article class="form-card-sm">
			if data.Error != "" {
				<div class="alert alert-danger">{ data.Error }</div>
			}
			<form method="post" action="/clients/create/">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<label for="name">
					Client name
					<input type="text" id="name" name="name" value={ data.Name } required/>
				</label>
				<div class="form-actions">
					<button type="submit">Create</button>
					<a role="button" class="secondary outline" href="/clients/">Cancel</a>
				</div>
			</form>
		</article>
	}
}

type ClientCreatedData struct {
	ClientID string
	Name     string
	APIKeyID string
	APIKey   string
}

templ ClientCreated(flashes []session.Flash, user layout.NavUser, data ClientCreatedData) {
	@layout.Base("Service Client Created", "clients", user, flashes) {
		<article class="form-card-lg">
			<h3>Service Client Created</h3>
			<p>Copy the API key now. It will not be shown again.</p>
			<div class="alert alert-warning">
				<strong>Client:</strong> { data.Name }<br/>
				<strong>API Key ID:</strong> <code>{ data.APIKeyID }</code><br/>
				<strong>API Key:</strong> <code>{ data.APIKey }</code>
			</div>
			<div class="toolbar">
				<a role="button" class="secondary outline" href="/clients/">Back to Clients</a>
				<a role="button" href={ templ.URL("/clients/" + data.ClientID + "/") }>View Details</a>
			</div>
		</article>
	}
}

type ClientDetailData struct {
	CSRFToken         string
	ID                string
	Name              string
	APIKeyID          string
	EncryptionKey     string
	IsActive          bool
	IsAuthApplication bool
	CreatedAt         string
	UpdatedAt         string
}

templ ClientDetail(flashes []session.Flash, user layout.NavUser, data ClientDetailData) {
	@layout.Base("Service Client Details", "clients", user, flashes) {
		<article class="form-card-xl">
			<div class="toolbar">
				<div>
					<h3 class="mb-1">{ data.Name }</h3>
					<p class="stat-label m-0">Service client details and status.</p>
				</div>
				if data.IsActive {
					<span class="badge badge-success">Active</span>
				} else {
					<span class="badge badge-secondary">Inactive</span>
				}
			</div>
			<div class="table-scroll">
				<table>
					<tbody>
						<tr><th>Name</th><td>{ data.Name }</td></tr>
						<tr><th>API Key ID</th><td><code>{ data.APIKeyID }</code></td></tr>
						<tr><th>ID</th><td><code>{ data.ID }</code></td></tr>
						<tr>
							<th>Encryption Key</th>
							<td>
								<div class="form-actions">
									<code>{ data.EncryptionKey }</code>
									<form method="post" action={ templ.URL("/clients/" + data.ID + "/regenerate-key/") } onsubmit="return confirm('Regenerate the encryption key? The current key stops working immediately.')">
										<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
										<button type="submit" class="btn-sm outline secondary"><i class="bi bi-arrow-repeat"></i> Regenerate</button>
									</form>
								</div>
							</td>
						</tr>
						<tr><th>Created</th><td>{ data.CreatedAt }</td></tr>
						<tr><th>Updated</th><td>{ data.UpdatedAt }</td></tr>
					</tbody>
				</table>
			</div>
			if data.IsAuthApplication {
				<div class="table-scroll">
					<h4>OIDC Identity Provider Endpoints</h4>
					<table>
						<tbody>
							<tr><th>Client ID</th><td><code>{ data.APIKeyID }</code></td></tr>
							<tr><th>Discovery</th><td><code>/.well-known/openid-configuration</code></td></tr>
							<tr><th>Authorization</th><td><code>/oauth2/authorize</code></td></tr>
							<tr><th>Token</th><td><code>/oauth2/token</code></td></tr>
							<tr><th>Userinfo</th><td><code>/oauth2/userinfo</code></td></tr>
						</tbody>
					</table>
				</div>
			}
			<div class="toolbar">
				<a role="button" class="secondary outline" href="/clients/">Back to Clients</a>
				<div class="actions">
					<a role="button" class="outline secondary" href={ templ.URL("/clients/" + data.ID + "/edit/") }>Edit</a>
					<form method="post" action={ templ.URL("/clients/" + data.ID + "/toggle/") }>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<button type="submit">Toggle Status</button>
					</form>
					<a role="button" class="btn-danger" href={ templ.URL("/clients/" + data.ID + "/delete/") }>Delete</a>
				</div>
			</div>
		</article>
	}
}

type ClientGroupOption struct {
	ID   string
	Name string
}

type ClientEditData struct {
	CSRFToken              string
	Action                 string
	ID                     string
	Name                   string
	IsAuthApplication      bool
	RequireConsent         bool
	RedirectURIs           string
	Applications           []GroupApplicationOption
	SelectedApplicationIDs map[string]bool
	Groups                 []ClientGroupOption
	SelectedGroupIDs       map[string]bool
	Error                  string
}

templ ClientEdit(flashes []session.Flash, user layout.NavUser, data ClientEditData) {
	@layout.Base("Edit Service Client", "clients", user, flashes) {
		<h2>Edit { data.Name }</h2>
		<article class="form-card-lg">
			if data.Error != "" {
				<div class="alert alert-danger">{ data.Error }</div>
			}
			<form method="post" action={ templ.URL(data.Action) }>
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<fieldset>
					<legend>Config/Flag Application Access (none selected = unrestricted)</legend>
					for _, app := range data.Applications {
						<label class="checkbox-inline">
							if data.SelectedApplicationIDs[app.ID] {
								<input type="checkbox" name="application_ids" value={ app.ID } checked/>
							} else {
								<input type="checkbox" name="application_ids" value={ app.ID }/>
							}
							{ app.Name }
						</label>
					}
				</fieldset>
				<fieldset>
					<legend>Identity Provider (OIDC)</legend>
					<label class="checkbox-inline">
						if data.IsAuthApplication {
							<input type="checkbox" name="is_auth_application" checked/>
						} else {
							<input type="checkbox" name="is_auth_application"/>
						}
						Enable as auth application
					</label>
					<label class="checkbox-inline">
						if data.RequireConsent {
							<input type="checkbox" name="require_consent" checked/>
						} else {
							<input type="checkbox" name="require_consent"/>
						}
						Require consent screen
					</label>
					<label for="redirect_uris">
						Redirect URIs (one per line)
						<textarea id="redirect_uris" name="redirect_uris" rows="4">{ data.RedirectURIs }</textarea>
					</label>
					<fieldset>
						<legend>Allowed Groups (none selected = any directory user)</legend>
						for _, g := range data.Groups {
							<label class="checkbox-inline">
								if data.SelectedGroupIDs[g.ID] {
									<input type="checkbox" name="allowed_group_ids" value={ g.ID } checked/>
								} else {
									<input type="checkbox" name="allowed_group_ids" value={ g.ID }/>
								}
								{ g.Name }
							</label>
						}
					</fieldset>
				</fieldset>
				<div class="form-actions">
					<button type="submit">Save</button>
					<a role="button" class="secondary outline" href={ templ.URL("/clients/" + data.ID + "/") }>Cancel</a>
				</div>
			</form>
		</article>
	}
}
