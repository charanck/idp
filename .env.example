# Copy this file to .env and fill in real values.
# Never commit .env - it is already in .gitignore.

DEBUG=True

# Session/CSRF signing secret. Falls back to DJANGO_SECRET_KEY (legacy name,
# kept for compatibility) if SESSION_SECRET is unset.
SESSION_SECRET=change-me-to-a-long-random-string

ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of scheme://host origins allowed to POST (only needed behind HTTPS/a proxy)
CSRF_TRUSTED_ORIGINS=

# Master Encryption Key - encrypts every config/secret value at rest. Required;
# the server refuses to start without it (no dev-only auto-generated fallback).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# Initial admin user - provisioned/synced on every startup from these values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Database - Postgres is required (no SQLite support).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=idp
DB_USER=idp
DB_PASSWORD=idp
DB_SSLMODE=disable

# Redis - required (sessions, caching, rate limiting all depend on it).
REDIS_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=idp
CACHE_TIMEOUT=300

# Rate limiting for POST /login/ - max requests per client IP per window.
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Rate limiting for S2S API-key requests, per client IP - every request counts toward the
# window, whether the key is valid or not (there's no separate failed-only tracking).
S2S_AUTH_RATE_LIMIT=20

# Optional OTLP traces/metrics/logs - unset disables observability entirely.
# OTEL_EXPORTER_OTLP_ENDPOINT=
