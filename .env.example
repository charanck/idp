# Copy this file to .env and fill in real values.
# Never commit .env - it is already in .gitignore.

DEBUG=True

# Session/CSRF signing secret. Falls back to DJANGO_SECRET_KEY (legacy name,
# kept for compatibility) if SESSION_SECRET is unset.
SESSION_SECRET=change-me-to-a-long-random-string

# Session cookie Domain attribute. Leave unset for exact-host-only cookies; set to a
# parent domain (e.g. .example.com) to share the session across subdomains a reverse
# proxy protects via forward-auth (see docs/configuration.md).
COOKIE_DOMAIN=

ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of scheme://host origins allowed to POST (only needed behind HTTPS/a proxy)
CSRF_TRUSTED_ORIGINS=

# Master Encryption Key - encrypts every config/secret value at rest. Required;
# the server refuses to start without it (no dev-only auto-generated fallback).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# Initial admin user - provisioned/synced on every startup from these values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Database - Postgres is required (no SQLite support).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=idp
DB_USER=idp
DB_PASSWORD=idp
DB_SSLMODE=disable

# Redis - required (sessions, caching, rate limiting all depend on it).
REDIS_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=idp
CACHE_TIMEOUT=300

# Rate limiting for POST /login/ - max requests per client IP per window.
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Rate limiting for S2S API-key requests, per client IP - every request counts toward the
# window, whether the key is valid or not (there's no separate failed-only tracking).
S2S_AUTH_RATE_LIMIT=20

# Minimum level for JSON stdout logging (debug/info/warn/error). Always active regardless
# of OTLP export below. Defaults to debug - this is a dev tool, so verbose-by-default logs
# are more useful than not; set to info or warn for quieter production logs.
LOG_LEVEL=debug

# Optional OTLP traces/metrics/logs export - unset disables OTLP export (stdout logging
# above still happens either way). Logs honor LOG_LEVEL whether or not this is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=
