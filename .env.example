# Copy this file to .env and fill in real values.
# Never commit .env - it is already in .gitignore.

# Core Django
DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of scheme://host origins allowed to POST (only needed behind HTTPS/a proxy)
CSRF_TRUSTED_ORIGINS=

# JWT (issued to users/services via the API)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Master Encryption Key - encrypts every config/secret value at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is auto-generated on startup for local convenience only -
# data becomes unreadable across restarts, and this must never happen in production.
MASTER_ENCRYPTION_KEY=

# Initial admin user - only used to provision the admin ONE TIME on first startup.
# Changing these after the admin user exists has no effect; use the web UI or
# `manage.py setup_admin` to update credentials afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Database - defaults to local SQLite. For Docker Compose / PostgreSQL, use:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=idp
# DB_USER=idp
# DB_PASSWORD=idp
# DB_HOST=localhost
# DB_PORT=5432
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Cache (fully optional; disabled by default)
CACHE_ENABLED=false
# CACHE_BACKEND=redis
# CACHE_TIMEOUT=300
# CACHE_KEY_PREFIX=idp
# REDIS_URL=redis://127.0.0.1:6379/1

# Rate limiting for /api/v1/auth/token, /api/v1/auth/register, and /login/ -
# max requests per client IP per window. Uses Redis if CACHE_ENABLED/
# CACHE_BACKEND=redis above, otherwise an in-process (single-worker) cache.
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
