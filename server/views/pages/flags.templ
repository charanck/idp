package pages

import "controlplane/internal/session"
import "controlplane/views/layout"
import "controlplane/internal/config"

type FlagGroup struct {
	ApplicationID   string
	ApplicationName string
	Name            string
	Description     string
	Entries         []FlagGroupEntry
}

type FlagGroupEntry struct {
	ID              string
	EnvironmentName string
	IsEnabled       bool
}

type FlagsListData struct {
	Groups    []FlagGroup
	CSRFToken string
	Page      int
	NumPages  int
	HasPrev   bool
	HasNext   bool
	PrevNum   int
	NextNum   int
	Window    []int
}

templ FlagsList(flashes []session.Flash, user layout.NavUser, data FlagsListData) {
	@layout.Base("Feature Flags", "flags", user, flashes) {
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h2 class="mb-0">Feature Flags</h2>
			<a class="btn btn-primary" href="/flags/create/"><i class="bi bi-plus-lg"></i> New Feature Flag</a>
		</div>
		if len(data.Groups) == 0 {
			<div class="alert alert-secondary">No feature flags yet.</div>
		}
		for _, group := range data.Groups {
			<div class="card shadow-sm mb-3">
				<div class="card-header">
					<strong>{ group.ApplicationName }</strong> / { group.Name }
					if group.Description != "" {
						<div class="text-muted small">{ group.Description }</div>
					}
				</div>
				<table class="table table-hover mb-0">
					<tbody>
						for _, entry := range group.Entries {
							<tr>
								<td style="width: 160px;">{ entry.EnvironmentName }</td>
								<td>
									if entry.IsEnabled {
										<span class="badge bg-success">Enabled</span>
									} else {
										<span class="badge bg-secondary">Disabled</span>
									}
								</td>
								<td class="text-end">
									<form method="post" action={ templ.URL("/flags/" + entry.ID + "/toggle/") } class="d-inline">
										<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
										<button class="btn btn-sm btn-outline-secondary" type="submit">Toggle</button>
									</form>
									<a class="btn btn-sm btn-outline-danger" href={ templ.URL("/flags/" + entry.ID + "/delete/") }>Delete</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		@PaginationNav("/flags/", "", data.Page, data.NumPages, data.HasPrev, data.HasNext, data.PrevNum, data.NextNum, data.Window)
	}
}

// FlagFormData has no environment field: a feature flag is always created
// across every environment of the selected application (see
// FeatureFlagForm's docstring / flag_create's create_all_environments=True).
type FlagFormData struct {
	CSRFToken     string
	Applications  []config.Application
	ApplicationID string
	Name          string
	Description   string
	IsEnabled     bool
	Error         string
}

templ FlagForm(flashes []session.Flash, user layout.NavUser, data FlagFormData) {
	@layout.Base("New Feature Flag", "flags", user, flashes) {
		<h2 class="mb-4">New Feature Flag</h2>
		<div class="card shadow-sm" style="max-width: 560px;">
			<div class="card-body p-4">
				if data.Error != "" {
					<div class="alert alert-danger">{ data.Error }</div>
				}
				<form method="post" action="/flags/create/">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<div class="mb-3">
						<label class="form-label" for="application">Application</label>
						<select class="form-select" id="application" name="application_id" required>
							<option value="">Select an application</option>
							for _, app := range data.Applications {
								if app.ID.String() == data.ApplicationID {
									<option value={ app.ID.String() } selected>{ app.Name }</option>
								} else {
									<option value={ app.ID.String() }>{ app.Name }</option>
								}
							}
						</select>
					</div>
					<div class="mb-3">
						<label class="form-label" for="name">Name</label>
						<input class="form-control" type="text" id="name" name="name" value={ data.Name } required/>
					</div>
					<div class="mb-3">
						<label class="form-label" for="description">Description</label>
						<input class="form-control" type="text" id="description" name="description" value={ data.Description }/>
					</div>
					<div class="form-check mb-3">
						if data.IsEnabled {
							<input class="form-check-input" type="checkbox" id="is_enabled" name="is_enabled" checked/>
						} else {
							<input class="form-check-input" type="checkbox" id="is_enabled" name="is_enabled"/>
						}
						<label class="form-check-label" for="is_enabled">Enabled</label>
					</div>
					<p class="text-muted small">This flag will be created for every environment of the selected application.</p>
					<button class="btn btn-primary" type="submit">Save</button>
					<a class="btn btn-secondary ms-2" href="/flags/">Cancel</a>
				</form>
			</div>
		</div>
	}
}
