package pages

import "controlplane/internal/auth"
import "controlplane/internal/session"
import "controlplane/views/layout"

type ClientsListData struct {
	Clients  []auth.ServiceClient
	Page     int
	NumPages int
	HasPrev  bool
	HasNext  bool
	PrevNum  int
	NextNum  int
	Window   []int
}

templ ClientsList(flashes []session.Flash, user layout.NavUser, data ClientsListData) {
	@layout.Base("Service Clients", "clients", user, flashes) {
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h2 class="mb-0">Service Clients</h2>
			<a class="btn btn-primary" href="/clients/create/"><i class="bi bi-plus-lg"></i> New Client</a>
		</div>
		<div class="card shadow-sm">
			<table class="table table-hover mb-0">
				<thead><tr><th>Name</th><th>API Key ID</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
				<tbody>
					if len(data.Clients) == 0 {
						<tr><td colspan="4" class="text-muted text-center py-4">No service clients yet.</td></tr>
					}
					for _, client := range data.Clients {
						<tr>
							<td>{ client.Name }</td>
							<td><code>
								if client.APIKeyID != nil {
									{ *client.APIKeyID }
								} else {
									-
								}
							</code></td>
							<td>
								if client.IsActive {
									<span class="badge bg-success">Active</span>
								} else {
									<span class="badge bg-secondary">Inactive</span>
								}
							</td>
							<td class="text-end">
								<a class="btn btn-sm btn-outline-secondary" href={ templ.URL("/clients/" + client.ID.String() + "/") }>View</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@PaginationNav("/clients/", "", data.Page, data.NumPages, data.HasPrev, data.HasNext, data.PrevNum, data.NextNum, data.Window)
	}
}

type ClientFormData struct {
	CSRFToken string
	Name      string
	Error     string
}

templ ClientForm(flashes []session.Flash, user layout.NavUser, data ClientFormData) {
	@layout.Base("New Service Client", "clients", user, flashes) {
		<h2 class="mb-4">New Service Client</h2>
		<div class="card shadow-sm" style="max-width: 480px;">
			<div class="card-body p-4">
				if data.Error != "" {
					<div class="alert alert-danger">{ data.Error }</div>
				}
				<form method="post" action="/clients/create/">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<div class="mb-3">
						<label class="form-label" for="name">Client name</label>
						<input class="form-control" type="text" id="name" name="name" value={ data.Name } required/>
					</div>
					<button class="btn btn-primary" type="submit">Create</button>
					<a class="btn btn-secondary ms-2" href="/clients/">Cancel</a>
				</form>
			</div>
		</div>
	}
}

type ClientCreatedData struct {
	ClientID string
	Name     string
	APIKeyID string
	APIKey   string
}

templ ClientCreated(flashes []session.Flash, user layout.NavUser, data ClientCreatedData) {
	@layout.Base("Service Client Created", "clients", user, flashes) {
		<div class="card shadow-sm border-success" style="max-width: 640px;">
			<div class="card-body p-4">
				<h3 class="text-success">Service Client Created</h3>
				<p class="text-muted">Copy the API key now. It will not be shown again.</p>
				<div class="alert alert-warning">
					<strong>Client:</strong> { data.Name }<br/>
					<strong>API Key ID:</strong> <code>{ data.APIKeyID }</code><br/>
					<strong>API Key:</strong> <code>{ data.APIKey }</code>
				</div>
				<div class="d-flex justify-content-between">
					<a class="btn btn-secondary" href="/clients/">Back to Clients</a>
					<a class="btn btn-primary" href={ templ.URL("/clients/" + data.ClientID + "/") }>View Details</a>
				</div>
			</div>
		</div>
	}
}

type ClientDetailData struct {
	CSRFToken     string
	ID            string
	Name          string
	APIKeyID      string
	EncryptionKey string
	IsActive      bool
	CreatedAt     string
	UpdatedAt     string
}

templ ClientDetail(flashes []session.Flash, user layout.NavUser, data ClientDetailData) {
	@layout.Base("Service Client Details", "clients", user, flashes) {
		<div class="card shadow-sm" style="max-width: 720px;">
			<div class="card-body p-4">
				<div class="d-flex justify-content-between align-items-center mb-4">
					<div>
						<h3 class="mb-1">{ data.Name }</h3>
						<p class="text-muted mb-0">Service client details and status.</p>
					</div>
					if data.IsActive {
						<span class="badge bg-success">Active</span>
					} else {
						<span class="badge bg-secondary">Inactive</span>
					}
				</div>
				<dl class="row">
					<dt class="col-sm-3">Name</dt>
					<dd class="col-sm-9">{ data.Name }</dd>
					<dt class="col-sm-3">API Key ID</dt>
					<dd class="col-sm-9"><code>{ data.APIKeyID }</code></dd>
					<dt class="col-sm-3">ID</dt>
					<dd class="col-sm-9"><code>{ data.ID }</code></dd>
					<dt class="col-sm-3">Encryption Key</dt>
					<dd class="col-sm-9">
						<code>{ data.EncryptionKey }</code>
						<form method="post" action={ templ.URL("/clients/" + data.ID + "/regenerate-key/") } class="d-inline" onsubmit="return confirm('Regenerate the encryption key? The current key stops working immediately.')">
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
							<button type="submit" class="btn btn-sm btn-outline-secondary ms-2"><i class="bi bi-arrow-repeat"></i> Regenerate</button>
						</form>
					</dd>
					<dt class="col-sm-3">Created</dt>
					<dd class="col-sm-9">{ data.CreatedAt }</dd>
					<dt class="col-sm-3">Updated</dt>
					<dd class="col-sm-9">{ data.UpdatedAt }</dd>
				</dl>
				<div class="d-flex justify-content-between mt-4">
					<a class="btn btn-secondary" href="/clients/">Back to Clients</a>
					<div class="d-flex gap-2">
						<form method="post" action={ templ.URL("/clients/" + data.ID + "/toggle/") }>
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
							<button type="submit" class="btn btn-warning">Toggle Status</button>
						</form>
						<a class="btn btn-danger" href={ templ.URL("/clients/" + data.ID + "/delete/") }>Delete</a>
					</div>
				</div>
			</div>
		</div>
	}
}
