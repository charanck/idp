package pages

import "controlplane/internal/config"
import "controlplane/internal/session"
import "controlplane/views/layout"

type EnvironmentGroup struct {
	Application  config.Application
	Environments []config.Environment
}

type EnvironmentsListData struct {
	Groups   []EnvironmentGroup
	Page     int
	NumPages int
	HasPrev  bool
	HasNext  bool
	PrevNum  int
	NextNum  int
	Window   []int
}

templ EnvironmentsList(flashes []session.Flash, user layout.NavUser, data EnvironmentsListData) {
	@layout.Base("Environments", "environments", user, flashes) {
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h2 class="mb-0">Environments</h2>
			<a class="btn btn-primary" href="/environments/create/"><i class="bi bi-plus-lg"></i> New Environment</a>
		</div>
		if len(data.Groups) == 0 {
			<div class="alert alert-secondary">No environments yet.</div>
		}
		for _, group := range data.Groups {
			<div class="card shadow-sm mb-3">
				<div class="card-header fw-semibold">{ group.Application.Name }</div>
				<table class="table table-hover mb-0">
					<tbody>
						for _, env := range group.Environments {
							<tr>
								<td>{ env.Name }</td>
								<td class="text-end">
									<a class="btn btn-sm btn-outline-secondary" href={ templ.URL("/environments/" + env.ID.String() + "/edit/") }>Edit</a>
									<a class="btn btn-sm btn-outline-danger" href={ templ.URL("/environments/" + env.ID.String() + "/delete/") }>Delete</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		@PaginationNav("/environments/", "", data.Page, data.NumPages, data.HasPrev, data.HasNext, data.PrevNum, data.NextNum, data.Window)
	}
}

type EnvironmentFormData struct {
	CSRFToken     string
	Applications  []config.Application
	ApplicationID string
	Name          string
	Error         string
	IsEdit        bool
	Action        string
}

templ EnvironmentForm(flashes []session.Flash, user layout.NavUser, data EnvironmentFormData) {
	@layout.Base("Environment", "environments", user, flashes) {
		<h2 class="mb-4">
			if data.IsEdit {
				Edit Environment
			} else {
				New Environment
			}
		</h2>
		<div class="card shadow-sm" style="max-width: 480px;">
			<div class="card-body p-4">
				if data.Error != "" {
					<div class="alert alert-danger">{ data.Error }</div>
				}
				<form method="post" action={ templ.URL(data.Action) }>
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<div class="mb-3">
						<label class="form-label" for="application">Application</label>
						<select class="form-select" id="application" name="application_id" required>
							for _, app := range data.Applications {
								if app.ID.String() == data.ApplicationID {
									<option value={ app.ID.String() } selected>{ app.Name }</option>
								} else {
									<option value={ app.ID.String() }>{ app.Name }</option>
								}
							}
						</select>
					</div>
					<div class="mb-3">
						<label class="form-label" for="name">Name</label>
						<input class="form-control" type="text" id="name" name="name" value={ data.Name } required/>
					</div>
					<button class="btn btn-primary" type="submit">Save</button>
					<a class="btn btn-secondary ms-2" href="/environments/">Cancel</a>
				</form>
			</div>
		</div>
	}
}
