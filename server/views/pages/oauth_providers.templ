package pages

import "controlplane/internal/auth"
import "controlplane/internal/session"
import "controlplane/views/layout"

type OAuthProvidersListData struct {
	Providers []auth.OAuthProvider
	Page      int
	NumPages  int
	HasPrev   bool
	HasNext   bool
	PrevNum   int
	NextNum   int
	Window    []int
	CSRFToken string
}

templ OAuthProvidersList(flashes []session.Flash, user layout.NavUser, data OAuthProvidersListData) {
	@layout.Base("OAuth Providers", "oauth_providers", user, flashes) {
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h2 class="mb-0">OAuth Providers</h2>
			<a class="btn btn-primary" href="/oauth/providers/create/"><i class="bi bi-plus-lg"></i> New Provider</a>
		</div>
		<div class="card shadow-sm">
			<table class="table table-hover mb-0">
				<thead><tr><th>Name</th><th>Client ID</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
				<tbody>
					if len(data.Providers) == 0 {
						<tr><td colspan="4" class="text-muted text-center py-4">No OAuth providers configured.</td></tr>
					}
					for _, p := range data.Providers {
						<tr>
							<td>{ p.Name }</td>
							<td><code>{ p.ClientID }</code></td>
							<td>
								if p.IsActive {
									<span class="badge bg-success">Active</span>
								} else {
									<span class="badge bg-secondary">Inactive</span>
								}
							</td>
							<td class="text-end">
								<form method="post" action={ templ.URL("/oauth/providers/" + p.ID.String() + "/toggle/") } class="d-inline">
									<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
									<button class="btn btn-sm btn-outline-secondary" type="submit">Toggle</button>
								</form>
								<a class="btn btn-sm btn-outline-secondary" href={ templ.URL("/oauth/providers/" + p.ID.String() + "/edit/") }>Edit</a>
								<a class="btn btn-sm btn-outline-danger" href={ templ.URL("/oauth/providers/" + p.ID.String() + "/delete/") }>Delete</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@PaginationNav("/oauth/providers/", "", data.Page, data.NumPages, data.HasPrev, data.HasNext, data.PrevNum, data.NextNum, data.Window)
	}
}

type OAuthProviderFormData struct {
	CSRFToken        string
	Title            string
	Action           string
	Name             string
	ClientID         string
	ClientSecret     string
	AuthorizationURL string
	TokenURL         string
	UserinfoURL      string
	Scope            string
	AutoCreateUsers  bool
	IsActive         bool
	Error            string
	IsEdit           bool
}

templ OAuthProviderForm(flashes []session.Flash, user layout.NavUser, data OAuthProviderFormData) {
	@layout.Base(data.Title, "oauth_providers", user, flashes) {
		<h2 class="mb-4">{ data.Title }</h2>
		<div class="card shadow-sm" style="max-width: 640px;">
			<div class="card-body p-4">
				if data.Error != "" {
					<div class="alert alert-danger">{ data.Error }</div>
				}
				<form method="post" action={ templ.URL(data.Action) }>
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<div class="mb-3">
						<label class="form-label" for="name">Name</label>
						<input class="form-control" type="text" id="name" name="name" placeholder="Google" value={ data.Name } required/>
					</div>
					<div class="mb-3">
						<label class="form-label" for="client_id">Client ID</label>
						<input class="form-control" type="text" id="client_id" name="client_id" placeholder="your-client-id" value={ data.ClientID } required/>
					</div>
					<div class="mb-3">
						<label class="form-label" for="client_secret">Client Secret</label>
						<input class="form-control" type="password" id="client_secret" name="client_secret" placeholder="your-client-secret" value={ data.ClientSecret }/>
						if data.IsEdit {
							<div class="form-text">Leave blank to keep the current secret.</div>
						}
					</div>
					<div class="mb-3">
						<label class="form-label" for="authorization_url">Authorization URL</label>
						<input class="form-control" type="url" id="authorization_url" name="authorization_url" placeholder="https://provider.com/oauth/authorize" value={ data.AuthorizationURL } required/>
					</div>
					<div class="mb-3">
						<label class="form-label" for="token_url">Token URL</label>
						<input class="form-control" type="url" id="token_url" name="token_url" placeholder="https://provider.com/oauth/token" value={ data.TokenURL } required/>
					</div>
					<div class="mb-3">
						<label class="form-label" for="userinfo_url">Userinfo URL</label>
						<input class="form-control" type="url" id="userinfo_url" name="userinfo_url" placeholder="https://provider.com/oauth/userinfo" value={ data.UserinfoURL }/>
					</div>
					<div class="mb-3">
						<label class="form-label" for="scope">Scope</label>
						<input class="form-control" type="text" id="scope" name="scope" placeholder="openid email profile" value={ data.Scope }/>
					</div>
					<div class="form-check mb-2">
						if data.AutoCreateUsers {
							<input class="form-check-input" type="checkbox" id="auto_create_users" name="auto_create_users" checked/>
						} else {
							<input class="form-check-input" type="checkbox" id="auto_create_users" name="auto_create_users"/>
						}
						<label class="form-check-label" for="auto_create_users">Auto-create users on first login</label>
					</div>
					<div class="form-check mb-3">
						if data.IsActive {
							<input class="form-check-input" type="checkbox" id="is_active" name="is_active" checked/>
						} else {
							<input class="form-check-input" type="checkbox" id="is_active" name="is_active"/>
						}
						<label class="form-check-label" for="is_active">Active</label>
					</div>
					<button class="btn btn-primary" type="submit">Save</button>
					<a class="btn btn-secondary ms-2" href="/oauth/providers/">Cancel</a>
				</form>
			</div>
		</div>
	}
}
