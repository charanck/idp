// Package layout provides the shared page chrome (sidebar/topbar/flash
// messages) for every web UI page, mirroring web_ui/templates/web_ui/base.html.
package layout

import "controlplane/internal/session"

// NavUser is the current-user view the layout needs to render the sidebar
// and topbar, decoupled from the auth package to avoid an import cycle with
// the webui package (which imports views/pages, which imports this package).
type NavUser struct {
	LoggedIn  bool
	Email     string
	IsStaff   bool
	CSRFToken string
}

templ Base(title string, activeNav string, user NavUser, flashes []session.Flash) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · Control Plane</title>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
			<link href="/static/app.css" rel="stylesheet"/>
		</head>
		<body class="bg-light">
			if user.LoggedIn {
				<div class="d-flex">
					@sidebar(activeNav, user)
					<div class="flex-grow-1 min-vw-0">
						@topbar(user)
						<main class="p-4">
							@Flashes(flashes)
							{ children... }
						</main>
					</div>
				</div>
			} else {
				<main class="container py-5" style="max-width: 480px;">
					@Flashes(flashes)
					{ children... }
				</main>
			}
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
		</body>
	</html>
}

templ sidebar(activeNav string, user NavUser) {
	<nav class="d-flex flex-column flex-shrink-0 p-3 bg-dark text-white vh-100" style="width: 250px;">
		<a href="/dashboard/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
			<span class="fs-5 fw-semibold">Control Plane</span>
		</a>
		<hr/>
		<ul class="nav nav-pills flex-column mb-auto">
			@navLink(activeNav, "dashboard", "/dashboard/", "bi-speedometer2", "Dashboard")
			@navLink(activeNav, "applications", "/applications/", "bi-grid-3x3-gap", "Applications")
			@navLink(activeNav, "environments", "/environments/", "bi-layers", "Environments")
			@navLink(activeNav, "configs", "/configs/", "bi-sliders", "Configs & Secrets")
			@navLink(activeNav, "flags", "/flags/", "bi-toggle-on", "Feature Flags")
			if user.IsStaff {
				@navLink(activeNav, "clients", "/clients/", "bi-hdd-network", "Service Clients")
				@navLink(activeNav, "users", "/users/", "bi-people", "Users")
				@navLink(activeNav, "oauth_providers", "/oauth/providers/", "bi-shield-lock", "OAuth Providers")
				@navLink(activeNav, "activity", "/activity/", "bi-clock-history", "Activity Log")
			}
		</ul>
	</nav>
}

templ navLink(activeNav, key, href, icon, label string) {
	<li class="nav-item">
		if activeNav == key {
			<a href={ templ.URL(href) } class="nav-link active" aria-current="page">
				<i class={ "bi", icon, "me-2" }></i>{ label }
			</a>
		} else {
			<a href={ templ.URL(href) } class="nav-link text-white">
				<i class={ "bi", icon, "me-2" }></i>{ label }
			</a>
		}
	</li>
}

templ topbar(user NavUser) {
	<nav class="navbar navbar-expand navbar-light bg-white border-bottom px-4">
		<span class="navbar-text ms-auto me-3 text-muted">{ user.Email }</span>
		<a class="btn btn-sm btn-outline-secondary me-2" href="/password/change/">Change Password</a>
		<form method="post" action="/logout/" class="d-inline m-0">
			<input type="hidden" name="csrf_token" value={ user.CSRFToken }/>
			<button class="btn btn-sm btn-outline-danger" type="submit">Logout</button>
		</form>
	</nav>
}

templ Flashes(flashes []session.Flash) {
	for _, f := range flashes {
		<div class={ "alert", "alert-" + bootstrapTag(f.Tag), "alert-dismissible", "fade", "show" } role="alert">
			{ f.Text }
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
}

func bootstrapTag(tag string) string {
	switch tag {
	case "success", "danger", "warning", "info":
		return tag
	case "error":
		return "danger"
	default:
		return "secondary"
	}
}
